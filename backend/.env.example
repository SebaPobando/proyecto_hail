# Copia este archivo a backend/.env y ajusta los valores.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos levantada con infra/compose.yaml (puerto 5433 para no chocar con un
# PostgreSQL instalado en el equipo, que suele usar el 5432).
# Sin Docker: DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://hail:hail@127.0.0.1:5433/hail

# Correo: en desarrollo se imprime en la consola
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
HAIL_FRONTEND_URL=http://localhost:5173

# Telemetría (broker de infra/compose.yaml)
HAIL_MQTT_URL=mqtt://127.0.0.1:1883
# Cuenta del worker de ingesta (solo lectura de telemetría)
HAIL_MQTT_USERNAME=hail-ingest
HAIL_MQTT_PASSWORD=cambia-esta-clave-de-ingesta
# Cuenta del simulador (solo desarrollo; déjala vacía en producción)
HAIL_MQTT_SIMULATOR_USERNAME=hail-simulator
HAIL_MQTT_SIMULATOR_PASSWORD=cambia-esta-clave-del-simulador
HAIL_TELEMETRY_STALE_SECONDS=30
HAIL_TELEMETRY_OFFLINE_SECONDS=60
