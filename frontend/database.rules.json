{
  "rules": {
    ".read": false,
    ".write": false,
    "portalAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "telemetry": {
      ".read": "auth != null && (root.child('operators').child(auth.uid).val() === true || root.child('portalAccess').child(auth.uid).child('admin').val() === true || root.child('portalAccess').child(auth.uid).child('projects').child('aguapozo').val() === true)",
      "history": {
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "projectData": {
      "$projectId": {
        ".read": "auth != null && (root.child('portalAccess').child(auth.uid).child('admin').val() === true || root.child('portalAccess').child(auth.uid).child('projects').child($projectId).val() === true)",
        ".write": false,
        "history": {
          ".indexOn": [
            "timestamp"
          ]
        },
        "events": {
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    }
  }
}